{
  // This package is a DNA layer: dna/ is hand-authored source and is the
  // last layer of its own instantiation.
  "version": 2,

  // The ggdna umbrella: it pulls in every topic layer, so adding this
  // one layer gives a repo the whole set. Parents first, this layer wins.
  // dna_helix comes first because every other layer builds on it.
  // dna_scripts comes along through dna_gg, which calls those scripts.
  "layers": [
    "dna_helix",
    "dna_readme",
    "dna_guides",
    "dna_translate",
    "dna_index",
    "dna_blog",
    "dna_install",
    "dna_vscode",
    "dna_clean_code",
    "dna_scripts",
    "dna_gg"
  ],

  // The topic layers ask every layer listing them for the copyright
  // holder, the quick check pipeline name and the identity of the
  // organization: company, GitHub org with its URL and ticket prefix.
  // dna/_vars.json sets the ones of this organization, so its repos need not set them again.
  "mustOverride": {
    "dnaCopyrightHolder": false,
    "dnaGitQuickCheckPipelineName": false,
    "dnaCompany": false,
    "dnaGitOrg": false,
    "dnaGitOrgUrl": false,
    "dnaJiraPrefix": false
  }
}
