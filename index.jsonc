{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "dna_ggdna",

  // 1-2 sentence summary about this repo.
  "summary": "Umbrella DNA of every ggdna repo: authoring DNA layers plus all topic layers. pub dna_ggdna, npm @ggdna/dna-ggdna.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "ggdna repo conventions in one layer",
    "DNA layer authoring via dna_helix",
    "org variables of ggdna: company, git org, ticket prefix GGD",
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "helix": "DNA engine",
      "dna_helix": "DNA authoring guide, /dna skill",
      "dna_readme, dna_guides, dna_translate, dna_index, dna_blog, dna_install, dna_vscode, dna_clean_code, dna_scripts, dna_gg": "topic layers",
    },

    // "<repo-b>": "why / API"
    "usedBy": {
      "helix-js": "layer",
      "ggdna repos": "layer",
    },
  },
}
